# Settings the site needs. These are PLACEHOLDERS, not real values.
# Real values are set in Cloudflare Pages > Settings > Variables and Secrets.
# Never put the Supabase service role key here or anywhere in the repo.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
